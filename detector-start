#!/usr/bin/env bash
SESSION="drone-detect"
if tmux has-session -t "$SESSION" 2>/dev/null; then
    echo "drone-detect is already running (tmux session: $SESSION)"
    exit 1
fi
PROJ_ROOT="$(realpath "$(dirname "$0")/..")"
LOG_DIR="$PROJ_ROOT/logs"
mkdir -p "$LOG_DIR"

tmux new-session -d -s "$SESSION" \
	"cd \"$PROJ_ROOT/drone_detect\" && LOG_PATH=\"$LOG_DIR/drone-detect_\$\$.log\" && ln -sf \"\$(basename \"\$LOG_PATH\")\" \"$LOG_DIR/drone-detect-latest.log\" && exec .venv/bin/python3 detector.py >> \"\$LOG_PATH\" 2>&1"
echo "Started drone-detect (tmux session: $SESSION)"
