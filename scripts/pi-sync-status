#!/usr/bin/env bash
# Run on the LAPTOP. Shows whether the laptop and the Pi agree on commits,
# and whether the Pi's working tree has any uncommitted (possibly
# field-made) edits.
set -euo pipefail
PROJ_ROOT="$(realpath "$(dirname "$0")/..")"
PI_HOST="rpi-ethernet"
PI_PATH="workspace/drone_detector"
BRANCH="main"

if ! git -C "$PROJ_ROOT" remote get-url pi >/dev/null 2>&1; then
    echo "no 'pi' remote configured -- see pi-git-setup.sh"
    exit 1
fi

git -C "$PROJ_ROOT" fetch pi -q
read -r ahead behind < <(git -C "$PROJ_ROOT" rev-list --left-right --count "$BRANCH...pi/$BRANCH")

if [ "$ahead" = 0 ] && [ "$behind" = 0 ]; then
    echo "commits: in sync"
elif [ "$behind" = 0 ]; then
    echo "commits: laptop is ahead by $ahead -- run pi-sync-push"
elif [ "$ahead" = 0 ]; then
    echo "commits: Pi is ahead by $behind -- run pi-sync-pull"
else
    echo "commits: DIVERGED (laptop +$ahead / Pi +$behind) -- run pi-sync-pull"
fi

dirty="$(ssh "$PI_HOST" "git -C $PI_PATH status --short" 2>/dev/null || echo "(could not check)")"
if [ -z "$dirty" ]; then
    echo "Pi working tree: clean"
else
    echo "Pi working tree: DIRTY"
    echo "$dirty" | sed 's/^/  /'
fi
