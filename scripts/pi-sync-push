#!/usr/bin/env bash
# Run on the LAPTOP. Deploys committed local changes to the Pi. Safe by
# construction: the Pi refuses the push if its working tree is dirty
# (receive.denyCurrentBranch=updateInstead), so this can never silently
# overwrite an uncommitted field edit.
set -euo pipefail
PROJ_ROOT="$(realpath "$(dirname "$0")/..")"
BRANCH="main"

if ! git -C "$PROJ_ROOT" remote get-url pi >/dev/null 2>&1; then
    echo "no 'pi' remote configured -- see pi-git-setup.sh"
    exit 1
fi

if ! git -C "$PROJ_ROOT" push pi "$BRANCH"; then
    echo "push failed -- Pi has diverged or dirty commits; run pi-sync-pull first"
    exit 1
fi
